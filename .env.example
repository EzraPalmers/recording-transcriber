# Copy to .env only if you need it. Every line here is commented out on
# purpose, so copying this file cannot overwrite a working setup.

# Fallback for GPU users who did not install the CUDA extra
# (uv sync --extra cuda) and whose CUDA libraries are not already on PATH.
# CUDA_PATH is the CUDA 12.x toolkit root, not its bin folder. CUDNN_PATH is
# the folder that holds the cuDNN 9 DLLs.
# CUDA_PATH=C:\Path\To\CUDA\v12.8
# CUDNN_PATH=C:\Path\To\cuDNN\bin\12.x\x64

# Optional. No model needs an account, but a Hugging Face token can speed up
# the first model download. HUGGINGFACE_TOKEN works as well.
# HF_TOKEN=hf_your_token_here
